# ==============================
# Database Configuration
# ==============================
POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string used by SQLAlchemy
DATABASE_URL=postgresql+psycopg2://raguser:changeme_strong_password@db:5432/rag_db

# ==============================
# App Configuration
# ==============================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================
# LLM Configuration (fill in later steps)
# ==============================
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ==============================
# Embedding Configuration
# ==============================
# Local model (runs inside the backend container, no API key needed,
# no document text ever leaves the server). Downloaded automatically
# on first run and cached in the container.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
